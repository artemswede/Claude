{
  // Cloudflare Worker. Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-1950",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // SPA из ./public; запросы без статики (например /api/*) уходят в Worker.
  "assets": { "directory": "./public" },
  // KV: анонимные счётчики + лиды. ID создать: `npx wrangler kv namespace create METRICS` и LEADS,
  // затем подставить сюда. Для `wrangler dev` работает локально без реальных ID.
  "kv_namespaces": [
    { "binding": "METRICS", "id": "REPLACE_WITH_METRICS_KV_ID" },
    { "binding": "LEADS", "id": "REPLACE_WITH_LEADS_KV_ID" }
  ],
  "observability": { "enabled": true }
}
