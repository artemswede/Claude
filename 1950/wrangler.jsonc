{
  // Cloudflare Worker. Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-1950",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // SPA из ./public; запросы без статики (например /api/*) уходят в Worker.
  "assets": { "directory": "./public" },
  "observability": { "enabled": true }

  // --- KV (опционально) ---------------------------------------------------------
  // Метрики и лиды работают только при подключённых KV. Без них приложение полностью
  // функционирует, но счётчики/лиды не сохраняются (код это безопасно игнорирует).
  // Чтобы включить:
  //   npx wrangler kv namespace create METRICS
  //   npx wrangler kv namespace create LEADS
  // и добавить сюда (заменив id):
  // "kv_namespaces": [
  //   { "binding": "METRICS", "id": "<METRICS_ID>" },
  //   { "binding": "LEADS",   "id": "<LEADS_ID>" }
  // ]
}
