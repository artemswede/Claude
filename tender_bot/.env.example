# --- Telegram ---
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# --- Источник данных ---
# mock        — встроенные демо-данные, ключ не нужен (для проверки бота)
# aggregator  — реальный платный агрегатор через REST API
PROVIDER=mock

# --- Настройки агрегатора (только при PROVIDER=aggregator) ---
# Базовый URL API вашего агрегатора (Контур.Закупки / Тендерплан / Seldon / ...)
AGGREGATOR_BASE_URL=https://api.example-aggregator.ru/v1
AGGREGATOR_API_KEY=your-api-key
# Путь метода поиска относительно base url
AGGREGATOR_SEARCH_PATH=/search
# Заголовок и схема авторизации. Примеры:
#   Authorization / Bearer       -> "Authorization: Bearer <key>"
#   X-API-Key     / (пусто)      -> "X-API-Key: <key>"
AGGREGATOR_AUTH_HEADER=Authorization
AGGREGATOR_AUTH_SCHEME=Bearer

# --- Фильтр ТБД ---
# Префиксы ОКПД2 (через запятую). 24.20 = стальные трубы.
OKPD2_PREFIXES=24.20
# Ключевые слова в наименовании (через запятую)
KEYWORDS=труб,тбд,большого диаметра
# Ограничения цены (рубли), необязательно
# MIN_PRICE=10000000
# MAX_PRICE=
# Показывать только завершённые закупки с определённым победителем
ONLY_WITH_WINNER=true

# --- Фоновая рассылка ---
POLL_INTERVAL_SECONDS=1800
POLL_LOOKBACK_DAYS=7
MAX_RESULTS_PER_QUERY=25

# --- Прочее ---
DATABASE_PATH=tender_bot.sqlite3
LOG_LEVEL=INFO
