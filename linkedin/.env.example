# Скопируйте в linkedin/.env и заполните.
# linkedin/.env добавлен в .gitignore — секрет в репозиторий не попадёт.

# Developer Portal -> ваше приложение -> вкладка Auth -> Application credentials
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Должен ПОБУКВЕННО совпадать со строкой в Auth -> Authorized redirect URLs.
# http разрешён только для localhost/127.0.0.1.
LINKEDIN_REDIRECT_URI=http://localhost:8765/callback

# Версия versioned API в формате YYYYMM. Версии живут ~12 месяцев.
LINKEDIN_API_VERSION=202605

# Запрашиваемые scope через пробел.
# openid profile email      -> Sign In with LinkedIn using OpenID Connect (self-serve)
# w_member_social           -> Share on LinkedIn (self-serve), публикация от лица человека
# w_organization_social     -> Community Management API (только по заявке), страница компании
LINKEDIN_SCOPES=openid profile email w_member_social

# Куда класть токен. По умолчанию ~/.config/linkedin-cli/token.json (права 0600).
#LINKEDIN_TOKEN_PATH=

# Обычно не нужно: person URN берётся из /v2/userinfo автоматически.
# Пригодится, если у токена нет scope openid/profile.
#LINKEDIN_PERSON_URN=urn:li:person:XXXXXXXX
